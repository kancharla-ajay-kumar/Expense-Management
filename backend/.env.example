# MongoDB connection string (Atlas for production or local for dev)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/spendwise?retryWrites=true&w=majority

# Secret key for JWT signing
JWT_SECRET=your_jwt_secret_key_here

# JWT token expiration (default: 7d)
JWT_EXPIRES_IN=7d

# Environment mode (development or production)
NODE_ENV=development

# Frontend client URL for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# Server port (assigned automatically in Render production)
PORT=5000
